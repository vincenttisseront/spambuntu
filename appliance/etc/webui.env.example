# Environnement de la console web (/etc/spambuntu/webui.env)
#
# HTTPS sur le port 8443, certificat auto-signé généré à l'installation (le navigateur affichera un
# avertissement tant que vous ne le remplacez pas par un certificat de confiance : déposez le vôtre
# dans /etc/spambuntu/tls/console.crt et console.key puis « systemctl restart spambuntu-webui »).
SPAMBUNTU_BIND=0.0.0.0:8443
SPAMBUNTU_TLS_ARGS=--certfile=/etc/spambuntu/tls/console.crt --keyfile=/etc/spambuntu/tls/console.key
