# Installé par install.sh dans /etc/sudoers.d/spambuntu-webui
# La console web (utilisateur « spambuntu ») ne peut lancer QUE :
#   - trois unités systemd, sans aucun argument libre (mise à jour, retour arrière, application de la
#     configuration de messagerie) : le travail privilégié est fait par l'unité, pas par la console ;
#   - les trois sous-commandes du programme de quarantaine, qui valide lui-même ses arguments.
Cmnd_Alias SPAMBUNTU_UPDATE = \
    /usr/bin/systemctl start --no-block spambuntu-update-apply.service, \
    /usr/bin/systemctl start --no-block spambuntu-update-rollback.service
Cmnd_Alias SPAMBUNTU_MAIL = \
    /usr/bin/systemctl start --no-block spambuntu-mail-apply.service, \
    /usr/local/sbin/spambuntu-quarantine list, \
    /usr/local/sbin/spambuntu-quarantine release * --actor *, \
    /usr/local/sbin/spambuntu-quarantine delete * --actor *
spambuntu ALL=(root) NOPASSWD: SPAMBUNTU_UPDATE, SPAMBUNTU_MAIL
