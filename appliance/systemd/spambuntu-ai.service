[Unit]
Description=Spambuntu - service d'analyse IA (client Ollama distant)
After=network-online.target
Wants=network-online.target

[Service]
User=spambuntu-ai
Group=spambuntu-ai
ExecStart=/usr/bin/python3 -I /opt/spambuntu/current/ai/spambuntu_aid.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryMax=256M
ReadWritePaths=/var/lib/spambuntu/ai /var/log/spambuntu/ai

[Install]
WantedBy=multi-user.target
